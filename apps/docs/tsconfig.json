{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@montionugera/ucsa-core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "vite.config.ts", "vite-plugins/**/*"]
}
